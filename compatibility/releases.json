{
  "schemaVersion": 1,
  "recordedAt": "2026-09-09",
  "scope": "Published 0.3.0 and historical 0.2.0 evidence. Public 0.3.0 Maven artifacts match the validated signed bundle.",
  "scenarios": {
    "migration-baseline-v1": [
      "fresh SQL migration",
      "two no-op updates",
      "single changelog row",
      "clear checksums, recalculate and validate",
      "abandoned lock recovery from a new CLI process",
      "update after recovery"
    ],
    "migration-capabilities-v2": [
      "all migration-baseline-v1 scenarios",
      "modifyDataType rejected without recording execution or changing the column",
      "failed SQL not recorded and lock released",
      "status, history, list-locks, tag and update-sql without mutation",
      "native PRIMARY creation, repeated update, checksum regeneration and rollback with escaped changeset identity",
      "native DUPLICATE creation, default VARCHAR/DECIMAL, duplicate rows and rollback",
      "snapshot, self diff and generate-changelog inspection",
      "custom metadata catalog/table names, tag, checksum and rollback",
      "two CLI processes racing on fresh metadata; one event and one changeset",
      "YAML/XML include, contexts, labels, SQL preconditions, runAlways and runOnChange",
      "idempotent recovery, lock timeout retaining ownership, orphan catalog reservation recovery",
      "tag tie selects exactly one changeset",
      "add/drop column with completion checks; rename/inverse where available"
    ]
  },
  "limitations": [
    "Only exact recorded combinations and named scenarios were exercised; unlisted patches are unverified.",
    "migration-baseline-v1 does not cover rollback, snapshots, concurrent processes or multi-node failover.",
    "migration-capabilities-v2 covers bounded inspection and two-process contention on single-node servers; it does not establish lossless diff replay, shared-data support or multi-node failover.",
    "StarRocks 3.1.7 does not support the tested rename operation or hyphenated metadata names; those boundaries are asserted by the suite.",
    "Historical image digests were not recorded; null does not mean a pinned image.",
    "Source-built 0.3.0-SNAPSHOT CI JARs were compared byte for byte with the signed 0.3.0 candidate. Detached signatures and publication status are recorded separately.",
    "Local evidence is distinguished from CI evidence; release logs and verification records are attached to the public release."
  ],
